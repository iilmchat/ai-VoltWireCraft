{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения окна: работа с файлами .vwc и диалогами выбора",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": ["**/*.vwc"]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": ["**/*.vwc"]
    }
  ]
}
