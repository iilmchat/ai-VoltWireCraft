{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoltWireCraft",
  "version": "0.8.0",
  "identifier": "ru.ruchating.voltwirecraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoltWireCraft",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iilmchat/ai-VoltWireCraft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNjc0NTU4NTlFNzc0OTUKUldTVmRPZFpXRVZuVzRwMk5GNFBJWVRJeVhUK0NNZHlYbUZ5TmNNVUF0WSttL25OTDI4Z09kbU4K"
    }
  }
}
