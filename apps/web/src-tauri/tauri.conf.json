{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoltWireCraft",
  "version": "0.2.0",
  "identifier": "ru.ruchating.voltwirecraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoltWireCraft",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
