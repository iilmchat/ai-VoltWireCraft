{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб- и десктоп-клиент VoltWireCraft (React 19, Vite, Konva.js, Tauri)",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @voltwirecraft/shared build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@voltwirecraft/shared": "workspace:*",
    "konva": "10.9.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
