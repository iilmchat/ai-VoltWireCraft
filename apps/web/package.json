{
  "name": "web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Веб- и десктоп-клиент VoltWireCraft (React 19, Vite, Konva.js, Tauri)",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @voltwirecraft/shared build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/three": "0.183.0",
    "@voltwirecraft/shared": "workspace:*",
    "jspdf": "4.2.1",
    "konva": "10.9.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "three": "0.183.0",
    "xlsx": "0.18.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
