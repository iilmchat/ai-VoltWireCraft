{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS API VoltWireCraft: контракты, валидация и маршрутизация",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@voltwirecraft/shared": "workspace:*",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
