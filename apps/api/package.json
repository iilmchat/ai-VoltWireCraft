{
  "name": "api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "NestJS API VoltWireCraft: контракты, валидация и маршрутизация",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed-catalog.ts",
    "db:seed:normatives": "tsx src/database/seed-normatives.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@voltwirecraft/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@nestjs/testing": "12.5.1",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
