# Шаблон переменных окружения VoltWireCraft.
# Скопируйте в .env и замените заглушки локальными значениями.
# НИКОГДА не коммитьте файл .env (RULES § 6.2).

# --- PostgreSQL 17 + pgvector ---
POSTGRES_USER=voltwirecraft
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_DB=voltwirecraft
# Внутри Docker Compose хост сервиса называется postgres; с хоста — localhost:5436.
POSTGRES_PORT=5436

# --- Redis 7 ---
REDIS_PORT=6381

# --- MinIO (S3-совместимое хранилище) ---
MINIO_ROOT_USER=replace-with-local-dev-user
MINIO_ROOT_PASSWORD=replace-with-local-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Хранилище подложек (локальная ФС или S3/MinIO) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/floor-plans
S3_BUCKET=voltwirecraft-floor-plans
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=replace-with-local-dev-user
S3_SECRET_ACCESS_KEY=replace-with-local-dev-password
S3_FORCE_PATH_STYLE=true

# --- Расчётное ядро (Python/FastAPI) ---
CALC_ENGINE_PORT=8000
# Сандбоксинг CAD-файлов: максимальный размер, МБ, и таймаут разбора, с (RULES § 5.5).
CAD_MAX_FILE_SIZE_MB=50
CAD_PARSE_TIMEOUT_SEC=30
# Конвертация DWG: auto (ODA, если задан путь, иначе dwg2dxf), oda, libredwg или none.
DWG_CONVERTER_TYPE=auto
# Путь к ODA File Converter внутри контейнера; оставьте пустым для LibreDWG.
ODA_CONVERTER_PATH=

# --- API (NestJS) ---
API_PORT=3000
WEB_PORT=5173
NODE_ENV=development
LOG_LEVEL=info
# JWT (SEC-01): секреты обязательны ВСЕГДА, статического/default значения нет.
# Сгенерируйте каждое значение отдельно: openssl rand -base64 48
# В production значения передаются через Docker secrets / secret manager.
JWT_SECRET=replace-with-random-32-character-secret-value
JWT_KID=v1
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_HASH_PEPPER=replace-with-random-32-character-pepper-value
HITL_SIGNING_KEY=replace-with-random-32-character-hitl-value
INTERNAL_SERVICE_TOKEN=replace-with-random-32-character-service-value
# F-04: разрешённые Origin для cookie-refresh; в production обязателен, wildcard запрещён.
# Пример: AUTH_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# F-03: лимиты auth-операций (общий Redis делается через REDIS_URL).
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REFRESH_MAX=10
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOGOUT_MAX=10
AUTH_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=300
# F-10: per-account login bucket; ключ — HMAC от нормализованного email.
AUTH_RATE_LIMIT_ACCOUNT_KEY=replace-with-random-32-character-account-key-value
AUTH_RATE_LIMIT_ACCOUNT_MAX=20
AUTH_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900

# --- LLM-роутер (OpenAI-совместимый API) ---
# Облачный вариант: LLM_BASE_URL=https://api.openai.com, LLM_MODEL=gpt-4o-mini
# Локальный LM Studio: LLM_BASE_URL=http://127.0.0.1:1234/v1, LLM_MODEL=qwen2.5-coder
# Локальный Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL=qwen2.5-coder
# Для локальных провайдеров ключ может быть заглушкой; реальный ключ — только в .env.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=replace-with-local-dev-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP-интеграции (опциональный profile `integrations`) ---
# Адреса MCP-серверов для API (в Docker по именам сервисов):
BITRIX24_MCP_URL=http://localhost:5003
MOYSKLAD_MCP_URL=http://localhost:5004
# Секреты передаются ТОЛЬКО в контейнеры MCP через .env / хранилище секретов.
BITRIX24_WEBHOOK_URL=
MOYSKLAD_TOKEN=
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
BITRIX24_MCP_PORT=5003
MOYSKLAD_MCP_PORT=5004
MCP_HTTP_TIMEOUT_SEC=10

# Строки подключения: при запуске в Docker используйте имена сервисов,
# при локальном запуске — localhost и порты из этого файла.
DATABASE_URL=postgresql://voltwirecraft:replace-with-local-dev-password@localhost:5436/voltwirecraft
REDIS_URL=redis://localhost:6381/0
CALC_ENGINE_URL=http://localhost:8000
